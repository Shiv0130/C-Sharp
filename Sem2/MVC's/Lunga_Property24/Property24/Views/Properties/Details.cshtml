@model Property24.Models.Property

@{
    ViewData["Title"] = "Property Details";
}

<h1 class="mb-3">@Model.Title</h1>

<div class="row">
    <div class="col-md-7">
        <img src="https://placehold.co/800x500?text=@Uri.EscapeDataString(Model.Category?.Name ?? "Property")"
             class="img-fluid rounded shadow-sm mb-3" alt="@Model.Title" />

        <h4>Description</h4>
        <p>@Model.Description</p>

        <h4>Address</h4>
        <p><i class="bi bi-geo-alt"></i> @Model.Address</p>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title text-success">R @Model.Price.ToString("N0")</h5>
                <p class="card-text">
                    <span class="badge bg-secondary">@(Model.Category?.Name ?? "Uncategorised")</span>
                </p>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Bedrooms</span> <strong>@Model.Bedrooms</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Bathrooms</span> <strong>@Model.Bathrooms</strong>
                    </li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header">Listing Agent</div>
            <div class="card-body">
                @if (Model.Agent != null)
                {
                    <p class="mb-1"><strong>@Model.Agent.FullName</strong></p>
                    <p class="mb-1"><i class="bi bi-envelope"></i> @Model.Agent.Email</p>
                    <p class="mb-0"><i class="bi bi-telephone"></i> @Model.Agent.PhoneNumber</p>
                }
                else
                {
                    <p class="text-muted mb-0">No agent assigned.</p>
                }
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>