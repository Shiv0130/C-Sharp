@model LogisticsCore.Models.DeliveryTruck
@{
    ViewData["Title"] = "Edit Truck";
}
<h1>Edit Truck</h1>
<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-2">
        <label asp-for="RegistrationNumber" class="form-label"></label>
        <input asp-for="RegistrationNumber" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="OdometerKm" class="form-label"></label>
        <input asp-for="OdometerKm" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="MaxPayloadKg" class="form-label"></label>
        <input asp-for="MaxPayloadKg" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="DepotId" class="form-label">Depot</label>
        <select asp-for="DepotId" class="form-select" asp-items="ViewBag.DepotId"></select>
    </div>
    <div class="mb-2">
        <label asp-for="DriverId" class="form-label">Driver</label>
        <select asp-for="DriverId" class="form-select" asp-items="ViewBag.DriverId"></select>
    </div>
    <div class="mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>