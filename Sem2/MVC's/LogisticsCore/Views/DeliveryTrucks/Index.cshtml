@model IEnumerable<LogisticsCore.Models.DeliveryTruck>
@{
    ViewData["Title"] = "Delivery Trucks";
}
<h1>Delivery Trucks</h1>
<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Registration</th>
            <th>Model</th>
            <th>Odometer</th>
            <th>Max Payload</th>
            <th>Depot</th>
            <th>Driver</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RegistrationNumber</td>
                <td>@item.Model</td>
                <td>@item.OdometerKm</td>
                <td>@item.MaxPayloadKg</td>
                <td>@item.Depot?.DepotName</td>
                <td>@item.Driver?.FullName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>