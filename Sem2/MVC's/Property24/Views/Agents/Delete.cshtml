@model Property24.Models.Agent

@{
    ViewData["Title"] = "Delete Agent";
    var listingCount = Model.Properties?.Count ?? 0;
}

<h1>Delete Agent</h1>

@if (listingCount > 0)
{
    <div class="alert alert-danger">
        <strong>Cannot delete this agent.</strong>
        They currently have <strong>@listingCount</strong> active listing@(listingCount == 1 ? "" : "s").
        Reassign or delete those listings first.
    </div>
}
else
{
    <div class="alert alert-warning">
        Are you sure you want to delete this agent? This action cannot be undone.
    </div>
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center me-3"
                 style="width:56px;height:56px;font-size:1.5rem;font-weight:bold;">
                @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "?")
            </div>
            <div>
                <h5 class="card-title mb-0">@Model.FullName</h5>
                <span class="badge bg-secondary">
                    @listingCount listing@(listingCount == 1 ? "" : "s")
                </span>
            </div>
        </div>
        <p class="mb-1"><i class="bi bi-envelope"></i> @(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</p>
        <p class="mb-0"><i class="bi bi-telephone"></i> @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</p>
    </div>
</div>

@if (listingCount > 0)
{
    <div class="mb-3">
        <h5>Listings owned by this agent:</h5>
        <ul class="list-group">
            @foreach (var property in Model.Properties!)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        <strong>@property.Title</strong>
                        <small class="text-muted d-block">@property.Address</small>
                    </span>
                    <span class="text-success">R @property.Price.ToString("N0")</span>
                </li>
            }
        </ul>
    </div>
}

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger" @(listingCount > 0 ? "disabled" : "")>
            Yes, Delete
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>