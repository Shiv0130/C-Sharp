@model IEnumerable<ActiveLife.Models.PersonalTrainingSession>
@{
    ViewData["Title"] = "Training Sessions";
}
<h1>Training Sessions</h1>
<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Date/Time</th>
            <th>Duration</th>
            <th>Fee</th>
            <th>Focus</th>
            <th>Trainer</th>
            <th>Member</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SessionDateTime</td>
                <td>@item.DurationMinutes</td>
                <td>@item.SessionFee</td>
                <td>@item.WorkoutFocus</td>
                <td>@item.Trainer?.TrainerName</td>
                <td>@item.GymMember?.FullName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>