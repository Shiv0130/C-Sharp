@model List<Staybnb.Controllers.AdminUserRow>
@{
    ViewData["Title"] = "Users (SuperAdmin)";
}

<h1>Users</h1>
<p class="text-muted">SuperAdmin can reset passwords and set roles. User must log out and back in after a role change.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="bg-white border rounded-3 p-3">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Email</th>
                <th>Name</th>
                <th>Roles</th>
                <th>Reset password</th>
                <th>Set role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.User.Email</td>
                    <td>@row.User.FirstName @row.User.LastName</td>
                    <td>@string.Join(", ", row.Roles)</td>
                    <td style="min-width:220px;">
                        <form asp-action="ResetPassword" method="post" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@row.User.Id" />
                            <input name="newPassword" class="form-control form-control-sm" placeholder="New password" required minlength="6" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Set</button>
                        </form>
                    </td>
                    <td style="min-width:200px;">
                        @if (!row.Roles.Contains("SuperAdmin"))
                        {
                            <form asp-action="SetRole" method="post" class="d-flex gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@row.User.Id" />
                                <select name="role" class="form-select form-select-sm">
                                    <option value="Guest">Guest</option>
                                    <option value="Host">Host</option>
                                    <option value="Admin">Admin</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Apply</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">SuperAdmin locked</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>