@model MVC_music.Models.Song

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>MVC_music.Models.Song</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Genre
        </dt>
        <dd class="col-sm-10">
            @Model!.Genre?.Name
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Artist
        </dt>
        <dd class="col-sm-10">
            @Model!.Artist?.Name
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="SongId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
