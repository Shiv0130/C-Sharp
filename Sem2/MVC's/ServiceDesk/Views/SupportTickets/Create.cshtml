@model ServiceDesk.Models.SupportTicket
@{
    ViewData["Title"] = "Create Ticket";
}
<h1>Create Ticket</h1>
<form asp-action="Create">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-2">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" class="form-select">
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
            <option value="Critical">Critical</option>
        </select>
    </div>
    <div class="mb-2 form-check">
        <input asp-for="IsResolved" class="form-check-input" />
        <label asp-for="IsResolved" class="form-check-label"></label>
    </div>
    <div class="mb-2">
        <label asp-for="EmployeeId" class="form-label">Employee</label>
        <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.EmployeeId"></select>
    </div>
    <div class="mb-2">
        <label asp-for="ItTechnicianId" class="form-label">Technician</label>
        <select asp-for="ItTechnicianId" class="form-select" asp-items="ViewBag.ItTechnicianId"></select>
    </div>
    <div class="mt-3">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</form>