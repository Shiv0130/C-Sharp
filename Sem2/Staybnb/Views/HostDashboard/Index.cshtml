@model IEnumerable<Staybnb.Models.HostProperty>
@{
    ViewData["Title"] = "Host dashboard";
}
<h1>Host dashboard</h1>
<div class="row mb-3">
    <div class="col"><div class="card p-3"><strong>@ViewBag.PropertyCount</strong> properties</div></div>
    <div class="col"><div class="card p-3"><strong>@ViewBag.ActiveCount</strong> active</div></div>
    <div class="col"><div class="card p-3"><strong>@ViewBag.PendingBookings</strong> pending bookings</div></div>
</div>
<a class="btn btn-primary" asp-action="MyProperties">My properties</a>
<a class="btn btn-secondary" asp-action="BookingRequests">Booking requests</a>
