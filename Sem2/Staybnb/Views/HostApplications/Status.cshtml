@model IEnumerable<Staybnb.Models.HostApplication>
@{
    ViewData["Title"] = "My host applications";
}
<h1>Application status</h1>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<table class="table table-striped">
    <thead>
        <tr>
            <th>Property</th>
            <th>Status</th>
            <th>Applied</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.Property?.Title</td>
            <td>@a.Status</td>
            <td>@a.AppliedAt.ToLocalTime()</td>
        </tr>
    }
    </tbody>
</table>
<a class="btn btn-secondary" asp-action="Create">New application</a>
