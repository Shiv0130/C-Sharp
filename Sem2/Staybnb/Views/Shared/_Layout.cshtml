<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybnb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">staybnb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Properties" asp-action="Index">Explore</a>
                        </li>

                        @if (User.IsInRole("Guest"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="HostApplications" asp-action="Create">Become a Host</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="HostApplications" asp-action="Status">Application status</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Bookings" asp-action="MyBookings">My bookings</a>
                            </li>
                        }

                        @if (User.IsInRole("Host"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="HostDashboard" asp-action="Index">Host dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="HostDashboard" asp-action="BookingRequests">Booking requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="CheckIn" asp-action="HostQueue">Check-in docs</a>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Applications">Host requests</a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Messages" asp-action="Inbox">Messages</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Notifications" asp-action="Index">Notifications</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Staybnb
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
