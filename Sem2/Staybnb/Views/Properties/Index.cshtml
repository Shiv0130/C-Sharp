@model IEnumerable<Staybnb.Models.HostProperty>
@{
    ViewData["Title"] = "Staybnb — Explore";
}
<h1>Find a stay</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="city" value="@ViewBag.City" class="form-control" placeholder="City" />
    </div>
    <div class="col-auto">
        <select name="propertyType" class="form-select">
            <option value="">Any type</option>
            <option>Apartment</option>
            <option>House</option>
            <option>Cabin</option>
            <option>Villa</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" type="submit">Filter</button>
    </div>
</form>
<div class="row">
@foreach (var p in Model)
{
    var img = p.Images.FirstOrDefault()?.ImageUrl ?? "/images/placeholder.jpg";
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <img src="@img" class="card-img-top" style="height:180px;object-fit:cover;" alt="@p.Title" />
            <div class="card-body">
                <h5 class="card-title">@p.Title</h5>
                <p class="card-text">@p.City · @p.PropertyType</p>
                <p><strong>R @p.PricePerNight.ToString("0.00")</strong> / night</p>
                <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@p.Id">View</a>
            </div>
        </div>
    </div>
}
</div>
